    "Opens the logger. The rectangular style also shows your pain-free days." : {
      "comment" : "Description of the complication in the watch face gallery.",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адкрывае запіс прыступу. Прамавугольны варыянт таксама паказвае дні без болю."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отваря записа на пристъп. Правоъгълният вариант показва и дните без болка."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre l’anotació d’una crisi. L’estil rectangular també mostra els vostres dies sense dolor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře záznam záchvatu. Obdélníková varianta ukazuje i dny bez bolesti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner registrering af anfald. Den rektangulære stil viser også dine smertefri dage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet das Eintragen einer Attacke. Die rechteckige Variante zeigt auch Ihre schmerzfreien Tage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίγει την καταγραφή κρίσης. Η ορθογώνια μορφή δείχνει επίσης τις μέρες χωρίς πόνο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el registro de una crisis. El estilo rectangular también muestra sus días sin dolor."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el registro de una crisis. El estilo rectangular también muestra sus días sin dolor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa kohtauksen kirjauksen. Suorakulmainen tyyli näyttää myös kivuttomat päiväsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre la saisie d’une crise. Le style rectangulaire affiche aussi vos jours sans douleur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre la saisie d’une crise. Le style rectangulaire affiche aussi vos jours sans douleur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvara bilježenje napadaja. Pravokutni stil prikazuje i dane bez boli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megnyitja a rohamrögzítést. A téglalap alakú változat a fájdalommentes napokat is mutatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka pencatat serangan. Gaya persegi panjang juga menampilkan hari bebas nyeri Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre l’annotazione di un attacco. Lo stile rettangolare mostra anche i suoi giorni senza dolore."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұстаманы жазуды ашады. Тікбұрышты нұсқасы ауырсынусыз күндерді де көрсетеді."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atidaro priepuolio įrašymą. Stačiakampis variantas rodo ir dienas be skausmo."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka pencatat serangan. Gaya segi empat tepat juga menunjukkan hari tanpa sakit anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpner registrering av anfall. Den rektangulære stilen viser også de smertefrie dagene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent het noteren van een aanval. De rechthoekige stijl toont ook uw pijnvrije dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera zapis napadu. Wariant prostokątny pokazuje też dni bez bólu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o registro de uma crise. O estilo retangular também mostra seus dias sem dor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
