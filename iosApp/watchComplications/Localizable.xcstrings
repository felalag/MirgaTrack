    "Opens the logger. The rectangular style also shows your pain-free days." : {
      "comment" : "Description of the complication in the watch face gallery.",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адкрывае запіс прыступу. Прамавугольны варыянт таксама паказвае дні без болю."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre l’anotació d’una crisi. L’estil rectangular també mostra els vostres dies sense dolor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet das Eintragen einer Attacke. Die rechteckige Variante zeigt auch Ihre schmerzfreien Tage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el registro de una crisis. El estilo rectangular también muestra sus días sin dolor."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el registro de una crisis. El estilo rectangular también muestra sus días sin dolor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre la saisie d’une crise. Le style rectangulaire affiche aussi vos jours sans douleur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre la saisie d’une crise. Le style rectangulaire affiche aussi vos jours sans douleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre l’annotazione di un attacco. Lo stile rettangolare mostra anche i suoi giorni senza dolore."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent het noteren van een aanval. De rechthoekige stijl toont ook uw pijnvrije dagen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o registro de uma crise. O estilo retangular também mostra seus dias sem dor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o registo de uma crise. O estilo retangular também mostra os seus dias sem dor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает запись приступа. Прямоугольный вариант также показывает дни без боли."
          }
        }
      }
    },
