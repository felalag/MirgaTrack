          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಟ್ಯಾಕ್ ದಾಖಲಿಸುವ ಪರದೆ ತೆರೆಯುತ್ತದೆ. ಆಯತಾಕಾರದ ಶೈಲಿ ನಿಮ್ಮ ನೋವಿಲ್ಲದ ದಿನಗಳನ್ನೂ ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발작 기록 화면을 엽니다. 직사각형 스타일에는 통증 없는 날도 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atidaro priepuolio įrašymą. Stačiakampis variantas rodo ir dienas be skausmo."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അറ്റാക്ക് രേഖപ്പെടുത്തുന്ന സ്ക്രീൻ തുറക്കുന്നു. ദീർഘചതുര ശൈലിയിൽ നിങ്ങളുടെ വേദനരഹിത ദിനങ്ങളും കാണാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "झटका नोंदवण्याची स्क्रीन उघडते. आयताकार प्रकारात तुमचे वेदनामुक्त दिवसही दिसतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka pencatat serangan. Gaya segi empat tepat juga menunjukkan hari tanpa sakit anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpner registrering av anfall. Den rektangulære stilen viser også de smertefrie dagene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent het noteren van een aanval. De rechthoekige stijl toont ook uw pijnvrije dagen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଟାକ୍ ରେକର୍ଡ କରିବା ସ୍କ୍ରିନ୍ ଖୋଲେ। ଆୟତାକାର ରୂପରେ ଆପଣଙ୍କ ପୀଡ଼ାମୁକ୍ତ ଦିନ ମଧ୍ୟ ଦେଖାଯାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਦੌਰਾ ਦਰਜ ਕਰਨ ਵਾਲੀ ਸਕ੍ਰੀਨ ਖੋਲ੍ਹਦਾ ਹੈ। ਆਇਤਾਕਾਰ ਰੂਪ ਵਿੱਚ ਤੁਹਾਡੇ ਦਰਦ-ਮੁਕਤ ਦਿਨ ਵੀ ਦਿਖਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera zapis napadu. Wariant prostokątny pokazuje też dni bez bólu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o registro de uma crise. O estilo retangular também mostra seus dias sem dor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o registo de uma crise. O estilo retangular também mostra os seus dias sem dor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschide înregistrarea unui atac. Stilul dreptunghiular arată și zilele fără durere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает запись приступа. Прямоугольный вариант также показывает дни без боли."
