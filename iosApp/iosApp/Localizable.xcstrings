    "Logs an episode now with your typical pain intensity and acute medications from MigraTrack." : {
      "comment" : "Description of the App Intent in the Shortcuts app.",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запісвае прыступ цяпер з вашай звычайнай інтэнсіўнасцю болю і лякарствамі для купіравання прыступу з MigraTrack."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota ara una crisi amb la vostra intensitat habitual del dolor i els medicaments per a la crisi de MigraTrack."
          }
        },
        "cs" : {
