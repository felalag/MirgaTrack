    "Logs an episode now with your typical pain intensity and acute medications from MigraTrack." : {
      "comment" : "Description of the App Intent in the Shortcuts app.",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запісвае прыступ цяпер з вашай звычайнай інтэнсіўнасцю болю і лякарствамі для купіравання прыступу з MigraTrack."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota ara una crisi amb la vostra intensitat habitual del dolor i els medicaments per a la crisi de MigraTrack."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trägt jetzt eine Attacke mit Ihrer typischen Schmerzintensität und Ihren Akutmedikamenten aus MigraTrack ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una crisis ahora con su intensidad habitual del dolor y sus medicamentos para la crisis de MigraTrack."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una crisis ahora con su intensidad habitual del dolor y sus medicamentos para la crisis de MigraTrack."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note une crise maintenant avec votre intensité habituelle et vos traitements de crise de MigraTrack."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note une crise maintenant avec votre intensité habituelle et vos traitements de crise de MigraTrack."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annota ora un attacco con la sua intensità abituale del dolore e i farmaci per l’attacco di MigraTrack."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noteert nu een aanval met uw gewone pijnintensiteit en aanvalsmedicatie uit MigraTrack."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra uma crise agora com sua intensidade habitual da dor e seus medicamentos para a crise do MigraTrack."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regista uma crise agora com a sua intensidade habitual da dor e os seus medicamentos para a crise do MigraTrack."
          }
