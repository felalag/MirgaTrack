    "Logged a migraine episode: intensity %lld of 10, with %@." : {
      "comment" : "Siri says this after a quick log. %1$lld = pain intensity, 1 to 10. %2$@ = medication names and doses, separated by commas.",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прыступ мігрэні запісаны: інтэнсіўнасць %1$lld з 10, лякарствы: %2$@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пристъпът на мигрена е записан: интензитет %1$lld от 10, лекарства: %2$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crisi de migranya anotada: intensitat %1$lld de 10, amb %2$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záchvat migrény zaznamenán: intenzita %1$lld z 10, léky: %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migræneanfald registreret: intensitet %1$lld af 10, med %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migräneattacke eingetragen: Intensität %1$lld von 10, mit %2$@."
