        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κρίση ημικρανίας καταγράφηκε: ένταση %1$lld από 10, φάρμακα: %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Logged a migraine episode: intensity %1$lld of 10, with %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crisis de migraña registrada: intensidad %1$lld de 10, con %2$@."
