{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "iOS shows this when the app asks for sleep data from Apple Health. Keep the promise that the data stays on the iPhone.",
      "extractionState" : "manual",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack счытвае сон мінулай ночы з Apple Health і паказвае яго ў зводцы. Даныя застаюцца на гэтым iPhone."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack llegeix la son d’aquesta nit de l’app Salut i la mostra al resum. Les dades es queden en aquest iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack čte spánek z minulé noci z aplikace Zdraví a zobrazuje ho v Přehledu. Data zůstávají v tomto iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack læser nattens søvn fra appen Sundhed og viser den i Oversigt. Dataene bliver på denne iPhone."
