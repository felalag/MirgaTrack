        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MigraTrack az Egészség appból olvassa be a tegnap éjjeli alvást, és megjeleníti az Összegzésben. Az adatok ezen az iPhone-on maradnak."
