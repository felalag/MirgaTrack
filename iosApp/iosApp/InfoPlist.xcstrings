{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "iOS shows this when the app asks for sleep data from Apple Health. Keep the promise that the data stays on the iPhone.",
      "extractionState" : "manual",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack счытвае сон мінулай ночы з Apple Health і паказвае яго ў зводцы. Даныя застаюцца на гэтым iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack reads last night's sleep from Apple Health and shows it on the Summary. The data stays on this iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack считывает сон прошлой ночи из приложения «Здоровье» и показывает его в сводке. Данные остаются на этом iPhone."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
