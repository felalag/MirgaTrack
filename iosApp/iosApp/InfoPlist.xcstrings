{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "iOS shows this when the app asks for sleep data from Apple Health. Keep the promise that the data stays on the iPhone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ MigraTrack نوم الليلة الماضية من تطبيق «صحتي» ويعرضه في الملخص. تبقى البيانات على هذا iPhone."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack счытвае сон мінулай ночы з Apple Health і паказвае яго ў зводцы. Даныя застаюцца на гэтым iPhone."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack чете съня от изминалата нощ от „Здраве“ и го показва в обобщението. Данните остават на този iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack গত রাতের ঘুম Apple Health থেকে পড়ে এবং সারসংক্ষেপে দেখায়। ডেটা এই iPhone-এই থাকে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack llegeix la son d’aquesta nit de l’app Salut i la mostra al resum. Les dades es queden en aquest iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack čte spánek z minulé noci z aplikace Zdraví a zobrazuje ho v Přehledu. Data zůstávají v tomto iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack læser nattens søvn fra appen Sundhed og viser den i Oversigt. Dataene bliver på denne iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack liest den Schlaf der letzten Nacht aus Apple Health und zeigt ihn in der Übersicht. Die Daten bleiben auf diesem iPhone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το MigraTrack διαβάζει τον χθεσινό ύπνο από την εφαρμογή «Υγεία» και τον δείχνει στη Σύνοψη. Τα δεδομένα μένουν σε αυτό το iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack reads last night's sleep from Apple Health and shows it on the Summary. The data stays on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack lee el sueño de anoche de la app Salud y lo muestra en el resumen. Los datos se quedan en este iPhone."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack lee el sueño de anoche de la app Salud y lo muestra en el resumen. Los datos se quedan en este iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack lukee viime yön unen Terveys-apista ja näyttää sen Yhteenvedossa. Tiedot pysyvät tässä iPhonessa."
          }
        },
        "fr" : {
          "stringUnit" : {
