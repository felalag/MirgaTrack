        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MigraTrack पिछली रात की नींद Apple Health से पढ़ता है और उसे सारांश में दिखाता है। डेटा इसी iPhone पर रहता है।"
