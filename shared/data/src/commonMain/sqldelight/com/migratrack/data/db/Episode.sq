-- Times are epoch milliseconds. Enums are stored by name.
CREATE TABLE episode (
    id TEXT NOT NULL PRIMARY KEY,
    started_at INTEGER NOT NULL,
    intensity INTEGER NOT NULL,
    region TEXT,
    -- Symptom names joined by commas.
    symptoms TEXT NOT NULL,
    source TEXT NOT NULL
);

CREATE INDEX episode_started_at ON episode(started_at);

CREATE TABLE medication_intake (
    episode_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    medication_id TEXT NOT NULL,
    name TEXT NOT NULL,
    dose TEXT NOT NULL,
    taken_at INTEGER NOT NULL,
    PRIMARY KEY (episode_id, position)
);

selectAll:
SELECT * FROM episode ORDER BY started_at DESC;

selectInRange:
SELECT * FROM episode WHERE started_at >= :from AND started_at < :until ORDER BY started_at;

selectAllIntakes:
SELECT * FROM medication_intake ORDER BY episode_id, position;

insertEpisode:
INSERT OR REPLACE INTO episode(id, started_at, intensity, region, symptoms, source)
VALUES (?, ?, ?, ?, ?, ?);

insertIntake:
INSERT INTO medication_intake(episode_id, position, medication_id, name, dose, taken_at)
VALUES (?, ?, ?, ?, ?, ?);

deleteEpisode:
DELETE FROM episode WHERE id = :id;

deleteIntakes:
DELETE FROM medication_intake WHERE episode_id = :episodeId;

deleteAllEpisodes:
DELETE FROM episode;

deleteAllIntakes:
DELETE FROM medication_intake;
